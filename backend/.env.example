APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = mysql
DATABASE = shishang_order
USERNAME = shishang
PASSWORD = CHANGE_ME
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = lj_

[REDIS]
HOST = redis
PORT = 6379
PASSWORD = CHANGE_ME

[CACHE]
DRIVER = redis
PREFIX = shishang:

[JWT]
SECRET = CHANGE_ME
EXPIRE = 7200

[WECHAT]
APPID = CHANGE_ME
SECRET = CHANGE_ME
; 登录驱动：mock 模拟登录 / miniprogram 真实小程序登录
LOGIN_DRIVER = mock
; 微信支付 APIv3 凭证（真实回调验签需齐备；骨架期可保持 CHANGE_ME）
MCH_ID = CHANGE_ME
API_V3_KEY = CHANGE_ME
PLATFORM_CERT_SERIAL = CHANGE_ME
PLATFORM_CERT_PATH = CHANGE_ME

[PAY]
; 支付回调严格验签开关：false 骨架期放行，凭证齐备后可改 true（兼容顶层 PAY_VERIFY_STRICT 写法）
VERIFY_STRICT = false

[ALIPAY]
APP_ID = CHANGE_ME
APP_PRIVATE_KEY = CHANGE_ME
ALIPAY_PUBLIC_KEY = CHANGE_ME

[SMS]
; 短信发送通道：mock 模拟 / aliyun 真实通道
DRIVER = mock
; aliyun 通道凭证（DRIVER = aliyun 时需齐备）
ACCESS_KEY_ID = CHANGE_ME
ACCESS_KEY_SECRET = CHANGE_ME
SIGN_NAME = CHANGE_ME
TEMPLATE_CODE = CHANGE_ME

[OSS]
ACCESS_KEY = CHANGE_ME
ACCESS_SECRET = CHANGE_ME
BUCKET = CHANGE_ME
ENDPOINT = CHANGE_ME

[CORS]
; 跨域白名单（逗号分隔，规范 §16）：生产域名 + 本地开发域名，按环境调整
ALLOWED_ORIGINS = https://admin.shengshikunyuan.com,https://api.shengshikunyuan.com,https://shop.shengshikunyuan.com,http://localhost:5173,http://localhost:5174
