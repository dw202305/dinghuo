{
    "name": "lianji/shishang-order-system",
    "description": "世尚门店订货系统 - 后端",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0",
        "topthink/think-view": "^2.0",
        "topthink/think-multi-app": "^1.1",
        "topthink/think-cache": "^3.0",
        "topthink/think-filesystem": "^2.0",
        "firebase/php-jwt": "^6.9",
        "overtrue/wechat": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "topthink/think-trace": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "topthink/think-trace": true
        },
        "audit": {
            "abandoned": "ignore"
        },
        "platform-check": false
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover"
        ]
    }
}
